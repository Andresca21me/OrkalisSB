# Sirve el SPA de Orkalis. Railway inyecta $PORT; en local por defecto 8080.
:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# ── Tarjeta de vista previa por negocio (Open Graph) ──────────────────────
	#
	# Los crawlers de WhatsApp, Facebook o Telegram NO ejecutan JavaScript: leen
	# el HTML tal como llega. Como esto es un SPA estático, todas las rutas
	# devuelven el mismo index.html y el enlace de un salón mostraría siempre la
	# tarjeta genérica de Orkalis.
	#
	# Solo para esos bots y solo en /reservar/*, la petición se reenvía a la API,
	# que genera el HTML con el nombre, la descripción y el logo del negocio. Las
	# personas siguen recibiendo el SPA de siempre.
	#
	# Va ANTES que los demás handle: en Caddy se evalúan en orden.
	@og {
		path /reservar/*
		header_regexp User-Agent (?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|slackbot|discordbot|linkedinbot|pinterest|redditbot|embedly|skypeuripreview|vkshare|w3c_validator|whatsapp-preview|googlebot|bingbot)
	}
	handle @og {
		rewrite * /api/og{uri}
		reverse_proxy {$API_ORIGIN:https://api.orkalis.com} {
			header_up Host {upstream_hostport}
		}
	}

	# Assets con hash → cache larga e inmutable y, sobre todo, SIN fallback SPA.
	#
	# Antes `try_files … /index.html` alcanzaba también a /assets/*: si alguien
	# tenía la app abierta cuando se desplegaba una versión nueva, su navegador
	# pedía un chunk con el hash viejo, recibía index.html con 200 e `import()`
	# intentaba ejecutar HTML como JavaScript → React.lazy fallaba y la pantalla
	# quedaba en blanco. Con `handle`, el asset inexistente devuelve un 404 limpio
	# y el ErrorBoundary del front lo detecta y recarga.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Todo lo demás es el documento del SPA (react-router resuelve la ruta en el
	# cliente). La cabecera va DENTRO del handle a propósito: puesta fuera con el
	# matcher `/index.html` solo aplicaba a esa ruta literal, así que `/`, `/admin`
	# o `/alta` se servían sin Cache-Control y el navegador cacheaba el documento
	# por heurística — dejando pegado un index.html que apunta a chunks ya
	# borrados. Con `no-cache` el navegador revalida siempre y un deploy nuevo se
	# ve en la siguiente carga.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
