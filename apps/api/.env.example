# General
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Rate limiting (RNF-011). Default 120 req/min por IP. Súbelo si varios usuarios
# del negocio comparten una sola IP pública (NAT) y ves 429 espurios.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Base de datos (FASE-02)
# Host 5433 (el 5432 puede estar ocupado por un Postgres del sistema). Ver docker-compose.yml.
# App: rol orkalis_app SIN superusuario → RLS forzada (FASE-04).
DATABASE_URL=postgres://orkalis_app:orkalis_app@localhost:5433/orkalis
# Admin: rol dueño/superusuario para migraciones, seed y fixtures de pruebas (FASE-04).
DATABASE_URL_ADMIN=postgres://orkalis:orkalis@localhost:5433/orkalis
# Auth (FASE-05)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900           # 15 min en segundos
JWT_REFRESH_TTL=1209600      # 14 días en segundos
# OTP / SMS (FASE-08 / FASE-11) — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Email (FASE-11) — SendGrid (opcional)
SENDGRID_API_KEY=
MAIL_FROM=
# Pasarela de suscripción — Mercado Pago (Plan-Pagos FASE-02)
# Credenciales de PRUEBA de tu aplicación en https://www.mercadopago.com.co/developers
MP_PUBLIC_KEY=          # TEST-… (también va en apps/web/.env como VITE_MP_PUBLIC_KEY)
MP_ACCESS_TOKEN=        # TEST-… (credencial privada del backend)
MP_WEBHOOK_SECRET=      # clave secreta del webhook (verifica x-signature)
MP_ENV=sandbox
